# Build artifacts (make / make sample)
core/build/
core/out/

# Object files and libraries (in case of in-tree builds)
*.o
*.a
*.so
*.so.*

# runtime files
*.bin

# Python bytecode
__pycache__/
*.pyc

# Python packaging artifacts
python/build/
python/dist/
python/*.egg-info/
python/**/gs130_images/

# ROS 2 / colcon build artifacts
ros/build/
ros/install/
ros/log/
ros2/build/
ros2/install/
ros2/log/

# Test and tool caches
.pytest_cache/

# Editor / OS noise
*.swp
*~
.DS_Store