<package format="3">
  <name>gs130_camera</name>
  <version>0.1.2</version>
  <description>
    ROS 2 driver for GS130 stereo cameras and optional IMU devices. It publishes
    images, camera calibration, inertial samples, and static sensor transforms
    through standard ROS 2 message and TF interfaces. The package links directly
    to the GS130 SDK C library, which has to be installed separately.
  </description>
  <maintainer email="hachi-leaf@users.noreply.github.com">hachi-leaf</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/D-Robotics/gs130_camera_sdk</url>

  <!-- Build system. -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Compile-time and runtime dependencies of the gs130_node executable. -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>tf2_ros</depend>

  <!-- Declare the package build type to the ament index. -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
